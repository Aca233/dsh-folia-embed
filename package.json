{
  "name": "dsh-folia-embed",
  "version": "0.6.1",
  "description": "把本机已安装的 Folia 的歌词舞台作为 DeepSeek Harness 的窗口背景：直接复用 Folia 自带的 OBS 浏览器源，不重画歌词动效",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aca233/dsh-folia-embed.git"
  },
  "homepage": "https://github.com/Aca233/dsh-folia-embed#readme",
  "bugs": {
    "url": "https://github.com/Aca233/dsh-folia-embed/issues"
  },
  "author": "Aca233",
  "license": "MIT",
  "os": [
    "win32"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepublishOnly": "node scripts/check-secrets.mjs && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "folia",
    "background",
    "obs",
    "lyrics"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
